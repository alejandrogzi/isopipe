{
    "_comment": "Copy this file, fill in your paths, and pass it with: nextflow run main.nf -params-file my_params.json",
    "// 1)": "Entrypoint / Global input options [ entrypoint: isoseq, map ] ───────────────────────────────────",
    "entrypoint": "isoseq",
    "global_input_dir": "",
    "global_output_dir": "",
    "global_genome": "",
    "global_annotation": "",
    "global_primers": "",
    "global_repeats": "",
    "global_prefix": "",
    "global_species_name": "",

    "// 2)": "CCS / Isoseq cluster options [ clustering: per_sample, multi_sample, both ] ─────",
    "ccs_chunk": 1000,
    "isoseq_cluster2_mode": "multi_sample",

    "// 2b)": "Chunking options ────────────────────────────────────────",
    "fxsplit_chunk_size": 50000,

    "// 3)": "Aligner options [ ark, mm2, ultra, desalt, pbmm2, flair ] ────────────────────────────────────────",
    "aligner": "ark",

    "// 3.1)": "Ark/Minimap2 options [ scoring options: spliceai, minisplice ] ────────────────────────────────────────",
    "minimap2_index_path": null,
    "minimap2_align_use_junc_bed": true,
    "minimap2_align_use_splice_scores": true,
    "minimap2_align_splicing_algorithm": "spliceai",

    "// 3.2)": "Ultra options ────────────────────────────────────────",
    "ultra_index": null,
    "ultra_use_annotation": true,
    "ultra_do_second_pass": true,

    "// 3.3)": "deSALT options ────────────────────────────────────────",
    "desalt_index": null,
    "desalt_use_annotation": false,

    "// 4)": "SpliceAI/minisplice options ────────────────────────────────────────",
    "spliceai_bigwigs_dir": null,
    "spliceai_scores_path": null,
    "minisplice_scores_path": null,

    "// 5)": "Isotools adapter / collapse / cigar options ────────────────────────────────────────",
    "isotools_adapter_remove_adapters": false,
    "isotools_cigar_extension_extend": true,
    "collapse_shrink_twins": false,

    "// 6)": "Isotools segment options ────────────────────────────────────────",
    "isotools_segment_identity_threshold": 98,
    "isotools_segment_max_five_prime_clip": 20,
    "isotools_segment_max_three_prime_clip": 20,

    "// 7)": "xORF options ────────────────────────────────────────",
    "xorf_custom_database": null,
    "xorf_chunk_size": 10,
    "xorf_predict_keep_raw": true,
    "xorf_predict_min_score_max_predictions": 0.50,
    "xorf_predict_max_predictions": 3,
    "xorf_predict_threshold": 0.01,
    "xorf_selenocysteine_codons": null,
    "xorf_skip_netstart": true,
    "xorf_rename_deactivate": false,

    "// 8)": "Track upload options ────────────────────────────────────────",
    "load_track": false
}

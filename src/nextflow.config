/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    alejandrogzi/ark Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

cleanup = false
workDir = 'work'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MANIFEST
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


manifest {
    name            = 'alejandrogzi/ark'
    author          = 'Alejandro Gonzales-Irribarren, Michael Hiller'
    homePage        = 'https://github.com/alejandrogzi/ark'
    description     = "A Reference pipeline to annotate euKaryotes at high resolution"
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.10.5'
    version         = '2.0.25'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile <docker/singularity/.../institute>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DEFAULT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params, used in configs
params {
    // Entrypoint
    entrypoint      = 'subreads'    // [ subreads, ccs, flnc ]

    // Global input options
    global_input_dir       =  ''         // FILL: input directory containing fastq files
    global_output_dir      =  ''         // FILL: output directory
    global_genome          =  ''         // FILL: path to genome file (2bit/fa/fa.gz)
    global_primers         =  ''         // FILL: path to primers fasta file (fa)
    global_annotation      =  ''         // FILL: path to annotation file (bed/gtf/gff/gff.gz)
    global_repeats         =  ''         // FILL: path to repeats file (bed3)
    global_env             =  null       // FILL: path to environment dir

    // Optional global input options
    global_species_name    =  ''         // FILL: species name [ controls loading tracks dir naming ]
    global_prefix   =  ''                // FILL: prefix for output files

    // CCS options
    ccs_chunk           =  16          // number of chunks [ default: 16 ]
    ccs_rq              =  0.95        // --min-rq [ default: 0.95 ]

    // Skera/Kinnex options
    skera_is_kinnex_library = false
    skera_kinnex_primers = "https://downloads.pacbcloud.com/public/dataset/MAS-Seq/REF-MAS_adapters/MAS-Seq_Adapter_v3/mas8_primers.fasta"

    // Isoseq cluster2 options
    isoseq_cluster2_mode    = "both" // per_sample, multi_sample, both

    // Bamtofa options
    bamtofa_keep_temp = false // keep temporary bam files [ default: false ]

    // SpliceAI options
    spliceai_bigwigs_dir       = null  // path to spliceai bigwigs [ optional; avoids raw run ]
    spliceai_scores_path       = null  // path to spliceai splice scores [ optional; avoids raw run + derived run ]
    spliceai_chunk_compression = false // compress spliceai chunks [ default: false ]

    // Aligner options
    aligner = "ark"  // [ options: mm2, ultra, desalt, flair, ark, pbmm2 ]

    // Minisplice options
    minisplice_scores_path = null  // path to minisplice splice scores [ optional; avoids raw run ]

    // Minimap2 index options
    minimap2_index_path = null  // path to minimap2 index [ optional ]

    // Minimap2 alignment options [ only applicable to ark aligner ]
    minimap2_align_max_intron_size      = "300k"     // max intron size [ default: 1600k ]
    minimap2_align_splice_alignment     = "splice:hq" // splice alignment [ default: splice:hq ]
    minimap2_align_secondary_alignments = "no"        // secondary alignments [ default: no ]
    minimap2_align_cigar_tag            = "long"      // cigar tag [ default: long ]
    minimap2_align_keep_sam             = false       // keep sam [ default: false ]
    minimap2_align_use_junc_bed         = true        // use junc bed [ default: true, maps to global_annotation ]
    minimap2_align_use_splice_scores    = false       // use splice scores [ default: false ]
    minimap2_align_splicing_algorithm   = "minisplice"  // splicing scoring algorithm [ options: spliceai, minisplice ]
    minimap2_align_junc_bonus           = 12           // junction bonus [ default: 12 ]
    minimap2_align_junc_penalty         = 5            // junction penalty [ default: 5 ]
    minimap2_align_do_second_pass       = true         // do second pass [ default: true ]
    minimap2_realign_intron_size        = "1600k"     // max intron size [ default: 1600k ]

    // Ultra options
    ultra_index = null            // path to ultra index [ optional ]
    ultra_use_annotation = true   // use annotation [ default: true ]
    ultra_max_intron_size = 300000 // max intron size [ default: 300kb ]

    // deSALT options
    desalt_index = null            // path to desalt index [ optional ]
    desalt_use_annotation = true   // use annotation [ default: true ]

    // pbmm2 options
    pbmm2_index = null            // path to pbmm2 index [ optional ]

    // Isotools adapter options
    isotools_adapter_remove_adapters     = true  // remove adapters [ default: true ]
    isotools_adapter_trim_polya          = true // trim polyA tails [ default: true ]
    isotools_adapter_max_edit_distance   = 3     // max edit distance for fuzzy matching [ default: 3 ]
    isotools_adapter_min_clip_length     = 20    // min soft-clip length for fuzzy matching [ default: 20 ]
    isotools_adapter_frequency_threshold = 10    // unknown-clip occurrence frequency threshold to flag [ default: 10 ]
    isotools_adapter_keep_minimap_bam    = false // keep minimap2 bam [ default: false ]

    // Isotools cigar extension options
    isotools_cigar_extension_extend      = true  // extend cigar [ default: true ]

    // Isotools find fragments options
    isotools_fragments_min_gap        = 150000  // min gap to be considered [ default: 150kb ]
    isotools_fragments_max_gap         = 1600000 // max gap to be considered [ default: 1600kb ]
    isotools_fragments_min_flank_clip = 20      // min flank clip to be considered [ default: 20bp ]
    isotools_fragments_flank_side     = 'inner' // flank side to be considered [ default: inner; options: inner, any ]

    // Fxsplit options
    fxsplit_chunk_size = 100 // chunk size for fxsplit [ default: 100 ]

    // Isotools segment options
    isotools_segment_min_identity = 60                   // min identity to be considered [ default: 60% ]
    isotools_segment_identity_threshold = 98             // identity threshold to determine HQ/LQ [ default: 98% ]
    isotools_segment_tail_suffix_length = 30             // tail suffix length; how many bp to consider as a tail [ default: 30bp ]
    isotools_segment_suffix_step_size = 50               // suffix step size [ default: 50bp ]
    isotools_segment_max_five_prime_clip = 20            // max 5' clip [ default: 20bp ]
    isotools_segment_max_three_prime_clip = 20           // max 3' clip [ default: 20bp ]
    isotools_segment_hmm_transition_probability = 0.9    // transition probability [ default: 0.9 ]
    isotools_segment_hmm_emission_probability = 0.99     // emission probability [ default: 0.99 ]
    isotools_segment_keep_low_quality_reads = false      // keep low quality reads [ default: false ]

    // Isotools collapse twins options
    collapse_shrink_twins = false                      // collapse highly repetitive reads [ default: false ]
    collapse_shrink_twins_five_prime_extension = 0     // max 5' extension [ default: 0bp ]
    collapse_shrink_twins_three_prime_extension = 0    // max 3' extension [ default: 0bp ]
    collapse_shrink_twins_mode = 'transcript'          // mode [ transcript, cds, exon ]

    // Isotools fusion options
    isotools_fusion_threshold = 0.5                      // fusion threshold [ default: 0.5 ]
    isotools_fusion_recover_components = true            // recover components [ default: true ]
    isotools_fusion_intronic_match = false               // intronic match instead of splice match [ default: false ]
    isotools_fusion_overlap_type = "exon"                // overlap type [ exon, cds, cds_bounded ]
    isotools_fusion_output_descriptor = true             // output descriptor [ default: true ]

    // xORF options
    xorf_protein_database                  =  'https://zenodo.org/records/21399231/files/diamond_db.tar.gz?download=1'    // [ default: UniProt/SwissProt ]
    xorf_custom_database                   =  null   // FILL: path to custom database [ optional; overrides xorf_protein_database ]
    xorf_chunk_size                        = 10     // chunk size [ default: 10 ]
    xorf_predict_keep_raw                  = true   // keep raw predictions [ default: false ]
    xorf_predict_min_score_max_predictions = 0.50   // min score to be considered [ default: 0.50 ]
    xorf_predict_max_predictions           = 3      // max predictions to be considered above min_score_max_predictions [ default: 3 ]
    xorf_predict_threshold                 = 0.5    // threshold to be considered [ default: 0.5 ]
    xorf_samba_weights = 'https://github.com/apcamargo/RNAsamba/raw/refs/heads/master/data/full_length_weights.hdf5'
    xorf_samba_local_weights               = null   // path to samba weights [ optional; avoids download ]
    xorf_selenocysteine_codons             = null   // FILL: path to selenocysteine codons [ optional; induces masking ]
    xorf_skip_netstart                     = true  // skip netstart [ default: true ]
    xorf_rename_deactivate                 = false // deactivate renaming of ORFs [ default: false ]
    xorf_rename_rebase                     = false // rebase ORF names with a hash [ default: false ]
    xorf_rename_append_orf_score           = true  // append ORF score to the name [ default: true ]
    xorf_rename_append_protein_name        = true  // append protein name to the name [ default: true ]
    xorf_rename_custom_prefix              = null  // custom prefix to be prepended to the name [ optional ]

    // Isotools NMD options
    isotools_nmd_distance            = 55   // distance to last exon junction [ default: 55 ]
    isotools_nmd_weak_distance       = 80   // weak distance to last exon junction [ default: 80 ]
    isotools_nmd_atg_distance        = 100  // distance to ATG [ default: 100 ]
    isotools_nmd_big_exon_dist_to_ej = 400  // distance to last exon junction for big exons [ default: 400 ]

    // xloci options [intron]
    xloci_upstream_flank = 100    // upstream flank [ default: 100 ]
    xloci_downstream_flank = 100  // downstream flank [ default: 100 ]

    // Isotools intron classifier options
    isotools_classify_spliceai_min_ss_signal     = 0.02 // min signal to be considered significant [ default: 0.02 ]
    isotools_classify_rt_frequency_threshold     = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_intron_frequency_threshold = 0.5  // frequency threshold to be considered [ default: 0.5 ]
    isotools_classify_maxent_min_ss_signal       = 1.5  // frequency threshold to be considered [ default: 0.5 ]

    // APARENT chunker options
    aparent_chunker_chunk_size       = 100 // chunk size [ default: 100 ]
    aparent_chunker_upstream_flank   = 100 // upstream flank [ default: 100bp ]
    aparent_chunker_downstream_flank = 100 // downstream flank [ default: 100bp ]

    // APARENT predict options
    aparent_peak_threshold  = 0.001           // peak threshold [ default: 0.001 ]
    aparent_predict_weights = 'https://github.com/johli/aparent/raw/refs/heads/master/saved_models/aparent_large_lessdropout_all_libs_no_sampleweights.h5'
    aparent_predict_weights_local_path = null // path to aparent weights [ optional; avoids download ]

    // Bigtools bedgraphtobigwig options
    bigtools_keep_bedgraph = false // keep temporary bedgraph files [ default: false ]

    // Collapse options
    collapse_five_prime_extension = 100 // 5' extension [ default: 100bp ]
    collapse_three_prime_extension = 500 // 3' extension [ default: 100bp ]
    collapse_mode = 'cds'                // mode [ transcript, cds, exon ]

    // Load tracks options
    load_track            = false                                   // WARN: upload to public browser [default: true]
    load_track_user       = 'agi'                                   // FILL: browser username
    load_track_server     = 'genome'                                // FILL: browser server [default: genome]
    load_track_target_dir = '/genome/gbdb-HL'                       // FILL: target output dir on server [prefix: isopipe]
    load_track_web        = '/genome/www/data'                      // FILL: web storage dir for .bb files
    load_track_browser    = 'http://genome.tbg.senckenberg.de/data' // FILL: browser URL
    load_track_name       = 'HLisopipe'                             // FILL: track name

    // Mailing options
    sent_email                   = false               // decides to send email or not
    smtp_server                  = 'smtp.gmail.com'  // smtp server [default: smtp.gmail.com]
    smtp_port                    = 465               // smtp port [default: 465]
    smtp_user                    = null              // smtp user [sender]
    smtp_password                = null              // smtp password [sender]
    smtp_security                = 'ssl'             // smtp security [none, tls, ssl]
    email_to                     = null              // recipient email address
    email_on_fail                = null              // email_on_fail
    plaintext_email              = false             // plaintext_email
    interactive                  = false             // interactive
    use_mailx                    = false             // use_mailx instead smtp

    // Boilerplate options
    publish_dir_mode             = 'copy'   // publish_dir_mode
    publish_all                  = false    // publish all
    help                         = false    // help
    help_full                    = false    // help_full
    show_hidden                  = false    // show_hidden
    version                      = false    // version
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')  // Config options

    // Config options
    config_profile_name        = null
    config_profile_description = null
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTENDING PROCESS DEFINITIONS AND ARGUMENTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Default publishing logic for pipeline


// Overwriting conda path for selected processes
process {
    if ( params.global_env ) {
        withName: '.*:PREPARE_INDEXES:.*' {
            conda = params.global_env
        }
        withName: '.*:PREPROCESS_READS:.*' {
            conda = params.global_env
        }
        withName: '.*:STAR_ALIGNMENT:.*' {
            conda = params.global_env
        }
        withName: '.*:ALETSCH' {
            conda = params.global_env
        }
        withName: '.*:MULTIQC' {
            conda = params.global_env
        }
        withName: '.*:EMAIL_RESULTS' {
            conda = params.global_env
        }
    }
}

// Default args for all processes

process {
    if ( params.publish_all ) {
        publishDir = [
            path: { "${params.global_output_dir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
            mode: params.publish_dir_mode ? params.publish_dir_mode : 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:PBCCS' {
        publishDir = [
            path: { "${params.global_output_dir}/01_PBCCS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = " --min-rq ${params.ccs_rq}"
    }

    withName: '.*:PBSKERA_SPLIT' {
        publishDir = [
            path: { "${params.global_output_dir}/02_PBSKERA_SPLIT" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:LIMA' {
        publishDir = [
            path: { "${params.global_output_dir}/02_LIMA" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "--isoseq",
              "--peek-guess",
              "--log-level INFO"
            ]

            if (params.skera_is_kinnex_library) {
              args += "--overwrite-biosample-names"
            }

            return args.join(' ')
        }
        ext.prefix = { "${meta.id}_fl" }
    }

    withName: '.*:ISOSEQ_REFINE' {
        publishDir = [
            path: { "${params.global_output_dir}/03_ISOSEQ_REFINE" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = { "${meta.id}_flnc" }
    }

    withName: '.*:ISOSEQ_CLUSTER' {
        publishDir = [
            path: { "${params.global_output_dir}/04_ISOSEQ_CLUSTER" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--singletons"
    }

    withName: '.*:ISOSEQ_CLUSTER2' {
        publishDir = [
            path: { "${params.global_output_dir}/04_ISOSEQ_CLUSTER2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--singletons"
        ext.prefix = { "${meta.id}_clustered" }
    }

    withName: '.*:ISOSEQ_CLUSTER2_MULTI_SAMPLE' {
        publishDir = [
            path: { "${params.global_output_dir}/04_ISOSEQ_CLUSTER2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = "--singletons"
        ext.prefix = { "${meta.id}_clustered" }
    }

    withName: '.*:BAM_TO_FA.*' {
        publishDir = [
            path: { "${params.global_output_dir}/05_BAM_TO_FA" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.keep_temp = { params.bamtofa_keep_temp }
    }

    withName: '.*:MINISPLICE_PREDICT|.*:SPLICEAI_DERIVE' {
        publishDir = [
            path: { "${params.global_output_dir}/00_SPLICING_SCORES" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SPLICEAI_DERIVE' {
        ext.args   = {
            // Standard configuration!
            def args = []

            if (params.minimap2_align_use_junc_bed && params.minimap2_align_use_splice_scores) {
                args += "--include-ss-from-regions --position-for-ss-regions cds --bonus"
            }

            return args.join(' ')
        }
        ext.use_junc_bed = { !params.minimap2_align_use_splice_scores }
    }

   withName: '.*:SPLICEAI_PUBLISH' {
        publishDir = [
             path: { "${params.global_output_dir}/00_SPLICEAI" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:MINIMAP2_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_MINIMAP2_INDEX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "-x splice:hq",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:ARK_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_ARK_INDEX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "-x ${params.minimap2_align_splice_alignment}",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:FLAIR_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_FLAIR_INDEX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "-x splice",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:MINIMAP2_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_MINIMAP2_ALIGN/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            // Standard PacBio Kinnex preset as per minimap2 docs
            def args = [ 
              "-uf",
              "-ax splice:hq",
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
        ext.use_junc_bed = { !params.minimap2_align_use_splice_scores }
    }

    withName: '.*:ARK_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_ARK_ALIGN/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            // Standard ark configuration!
            def args = [ 
              "-a",
              "-c",
              "--eqx",
              "-uf",
              "-C5",
              "-G ${params.minimap2_align_max_intron_size}",
              "-ax ${params.minimap2_align_splice_alignment}",
              "--secondary=${params.minimap2_align_secondary_alignments}",
              "-cs ${params.minimap2_align_cigar_tag}",
              "--junc-bonus ${params.minimap2_align_junc_bonus}",
              "--junc-pen ${params.minimap2_align_junc_penalty}",
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
        ext.use_junc_bed = { !params.minimap2_align_use_splice_scores }
    }

    withName: '.*:ARK_ALIGN_FRAGMENTS' {
        publishDir = [
            path: { "${params.global_output_dir}/06_ARK_ALIGN/FRAGMENTS/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            // Standard configuration!
            def args = [ 
              "-a",
              "-c",
              "--eqx",
              "-uf",
              "-C5",
              "-G ${params.minimap2_realign_intron_size}",
              "-ax ${params.minimap2_align_splice_alignment}",
              "--secondary=${params.minimap2_align_secondary_alignments}",
              "-cs ${params.minimap2_align_cigar_tag}",
              "--junc-bonus ${params.minimap2_align_junc_bonus}",
              "--junc-pen ${params.minimap2_align_junc_penalty}",
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
        ext.use_junc_bed = { !params.minimap2_align_use_splice_scores }
    }

    withName: '.*:ULTRA_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_ULTRA_INDEX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:ULTRA_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_ULTRA_ALIGN/BAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [ 
              "--max_intron ${params.ultra_max_intron_size}",
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    withName: '.*:DESALT_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_DESALT_INDEX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:DESALT_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_DESALT_ALIGN/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [ 
              "-x ccs",
              "-O6,24",
              "-M4"
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    withName: '.*:PBMM2_INDEX' {
        publishDir = [
            path: { "${params.global_output_dir}/06_PBMM2_INDEX" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "-x splice",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:PBMM2_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_PBMM2_ALIGN/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            def args = [
              "--preset ISOSEQ",
            ]

            return args.join(' ')
        }
    }


    withName: '.*:FLAIR_ALIGN' {
        publishDir = [
            path: { "${params.global_output_dir}/06_FLAIR_ALIGN/SAM" },
            mode: 'symlink', // INFO: avoid copying large .sam files
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            // Standard configuration!
            def args = [ 
              "-G 200k",
              "-ax splice",
              "--secondary=no",
              "-s 80"
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    withName: '.*:SAMTOOLS_BAM_FLAIR_ALIGN' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/06_FLAIR_ALIGN/BAM" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SAMTOOLS_BAM_DESALT_ALIGN' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/06_DESALT_ALIGN/BAM" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SAMTOOLS_BAM_PBMM2_ALIGN' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/06_PBMM2_ALIGN/BAM" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SAMTOOLS_BAM_MINIMAP2_ALIGN|.*:SAMTOOLS_MERGE_BAM_MULTI_SAMPLE_MINIMAP2' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/06_MINIMAP2_ALIGN/BAM" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    withName: '.*:SAMTOOLS_BAM_ARK_ALIGN|.*:SAMTOOLS_MERGE_BAM_MULTI_SAMPLE_ARK' {

            ]

            return args.join(' ')
        }
    }

    withName: '.*:FXSPLIT' {
        ext.chunks = params.fxsplit_chunk_size
        errorStrategy = 'ignore'
    }

    withName: '.*:ISOTOOLS_SEGMENT_POLYA' {
        publishDir = [
            path: { "${params.global_output_dir}/07_ISOTOOLS_SEGMENT_POLYA" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.keep_temp = { params.isotools_segment_keep_low_quality_reads }
        ext.args   = {
            // Standard configuration!

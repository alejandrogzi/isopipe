    withName: '.*:ISOTOOLS_FUSION.*' {
        publishDir = [
            path: { "${params.global_output_dir}/08_ISOTOOLS_FUSION_DETECTOR" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.keep_temp = { params.isotools_segment_keep_low_quality_reads }
        ext.args   = {
            // Standard configuration!
            def args = [ 
              "--threshold ${params.isotools_fusion_threshold}",
              "--overlap-type ${params.isotools_fusion_overlap_type}",
              "--tag",
            ]

            if (params.isotools_fusion_recover_components) {
                args += "--recover"
            }

            if (params.isotools_fusion_intronic_match) {
                args += "--intron-match"
            }

            if (params.isotools_fusion_output_descriptor) {
                args += "--descriptor"
            }

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    // Add params to concat
    withName: '.*:XORF_PREDICT_ORFS:CONCAT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/09_XORF_PREDICTION/CONCAT/${meta.name}" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:XORF_PREDICT_ORFS:CONCAT_RAW' {
        ext.prefix = { "${meta.id}" }
        publishDir = [

              "--freq-threshold ${params.isotools_adapter_frequency_threshold}",
            ]

            if (params.isotools_adapter_trim_polya) {
                args += "--trim-polya"
            }

            return args.join(' ')
        }
        ext.keep_temp = { params.isotools_adapter_keep_minimap_bam }
    }

   withName: '.*:ISOTOOLS_FIND_FRAGMENTS' {
        publishDir = [
            path: { "${params.global_output_dir}/06_MINIMAP2_ALIGN/FRAGMENTS" },

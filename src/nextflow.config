              "--min-identity ${params.isotools_segment_min_identity}",
              "--identity ${params.isotools_segment_identity_threshold}",
              "--tail-suffix ${params.isotools_segment_tail_suffix_length}",
              "--step-size ${params.isotools_segment_suffix_step_size}",
              "--clip5 ${params.isotools_segment_max_five_prime_clip}",
              "--clip3 ${params.isotools_segment_max_three_prime_clip}",
              "--p2p ${params.isotools_segment_hmm_transition_probability}",
              "-E ${params.isotools_segment_hmm_emission_probability}",
              "--tag",
              "-B",
              "-X"
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

    withName: '.*:ISOTOOLS_SEGMENT_POLYA_FRAGMENTS' {

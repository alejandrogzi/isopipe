        publishDir = [
             path: { "${params.global_output_dir}/09_XORF_PREDICTION/FUSION_CONCAT_RAW/${meta.name}" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:NETSTART' {
        containerOptions = '--env HF_HUB_OFFLINE=1 --env TRANSFORMERS_OFFLINE=1 --env NETSTART2_ALLOW_HF_DOWNLOAD=0 --env HF_HOME=/scratch'
    }

    withName: '.*:PREDICT' {
        ext.when = true
        ext.min_score_max_predictions = params.xorf_predict_min_score_max_predictions
        ext.max_predictions = params.xorf_predict_max_predictions
        ext.threshold = params.xorf_predict_threshold
        ext.args   = {
            // Standard configuration!
            def base_args = []

            if (params.xorf_predict_keep_raw) {
              base_args = base_args + ' --keep-raw'
            }
            
            if (base_args.size() > 0) {
              return base_args.join(' ')
            } else {
              return ''
            }
        }
    }

    withName: '.*:RENAME_PREDICTIONS' {
          publishDir = [
              path: { "${params.global_output_dir}/09_XORF_PREDICTION/RENAME/${meta.name}" },
              mode: params.publish_dir_mode,
              saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
          ]
          ext.args   = {
              // Standard configuration!
              def args = [ ]

              if (params.xorf_rename_rebase) {
                  args += "--rebase"
              }

              if (params.xorf_rename_append_orf_score) {
                  args += "--append-orf-score"
              }

              if (params.xorf_rename_append_protein_name) {
                  args += "--append-protein-name"
              }

              if (params.xorf_rename_custom_prefix) {
                  args += "--custom-prefix ${params.xorf_rename_custom_prefix}"
              }

              return args.join(' ')
          }
    }

    withName: '.*:RENAME_PREDICTIONS_RAW' {
          publishDir = [
              path: { "${params.global_output_dir}/09_XORF_PREDICTION/RENAME_RAW/${meta.name}" },
              mode: params.publish_dir_mode,
              saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
          ]
          ext.args   = {
              // Standard configuration!
              def args = [ ]

              if (params.xorf_rename_rebase) {
                  args += "--rebase"
              }

              if (params.xorf_rename_append_orf_score) {
                  args += "--append-orf-score"
              }

              if (params.xorf_rename_append_protein_name) {
                  args += "--append-protein-name"
              }

              if (params.xorf_rename_custom_prefix) {
                  args += "--custom-prefix ${params.xorf_rename_custom_prefix}"
              }

              return args.join(' ')
          }
    }

    withName: '.*:ISOTOOLS_NMD_FILTER' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/10_ISOTOOLS_NMD_FILTER" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
              "--nmd-distance ${params.isotools_nmd_distance}",
              "--weak-nmd-distance ${params.isotools_nmd_weak_distance}",
              "--atg-distance ${params.isotools_nmd_atg_distance}",
              "--big-exon-dist-to-ej ${params.isotools_nmd_big_exon_dist_to_ej}",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:XLOCI_EXTRACT_INTRONS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/11_PREPOLISH/INTRONS" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
              "--upstream-flank ${params.xloci_upstream_flank}",
              "--downstream-flank ${params.xloci_downstream_flank}",
              "--split-extraction",
              "--as-tsv",
              "--add-tab",
              "--generic-id"
            ]

            return args.join(' ')
        }
    }

    withName: '.*:IIC_PREDICT_SPLICEOSOME' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/11_PREPOLISH/IIC" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
                "--no-abbreviate"
            ]

            return args.join(' ')
        }
    }

    withName: '.*:ISOTOOLS_CLASSIFY_INTRON' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/11_PREPOLISH/CLASSIFY" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            // Standard configuration!
            def args = [ 
              "--scan",
              "--nag",
              "-S ${params.isotools_classify_spliceai_min_ss_signal}",
              "-F ${params.isotools_classify_rt_frequency_threshold}",
              "-f ${params.isotools_classify_intron_frequency_threshold}",
              "-M ${params.isotools_classify_maxent_min_ss_signal}"
            ]

            return args.join(' ')
        }
    }

    withName: '.*:XISO_APARENT_CHUNK' {
        ext.prefix = { "${meta.id}" }
        ext.args = {
            // Standard configuration!
            def args = [ 
                "--upstream ${params.xloci_upstream_flank}",
                "--downstream ${params.xloci_downstream_flank}",
                "--chunks ${params.aparent_chunker_chunk_size}",
            ]

            return args.join(' ')
        }
    }

    withName: '.*:APARENT_PREDICT' {
        ext.prefix = { "${meta.id}.${meta.chunk}" }
        ext.args = {
            // Standard configuration!
            def args = [ 
                "--threshold ${params.aparent_peak_threshold}",
            ]

            return args.join(' ')
        }
    }

   withName: '.*:BIGTOOLS_BIGWIGMERGE_FORWARD|.*:BIGTOOLS_BIGWIGMERGE_REVERSE' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/11_PREPOLISH/APARENT" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

   withName: '.*:DETACH_PASS_DUPLICATES|.*:JOIN_VEREDICT_TRASH|.*:JOIN_VEREDICT_RETENTIONS|.*:JOIN_VEREDICT_TRUNCATIONS|.*:JOIN_VEREDICT_INTRAPRIMMING|.*:JOIN_FUSIONS|.*:JOIN_NMD|.*:ISOTOOLS_ORPHAN_FINDER|.*:JOIN_VEREDICT_RT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/12_POLISH/BED" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

   withName: '.*:PUBLISH_BIGBEDS|.*:PUBLISH_ADDITIONAL_BIGBEDS' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/12_POLISH/BB" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

   withName: '.*:COLLAPSE_PASSES' {
        publishDir = [
             path: { "${params.global_output_dir}/12_POLISH/BED/collapsed" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            def args = [ 
                "--max-five-utr-length ${params.collapse_five_prime_extension}",
                "--max-three-utr-length ${params.collapse_three_prime_extension}",
                "--collapse-mode ${params.collapse_mode}",
            ]

            return args.join(' ')
        }
    }

   withName: '.*:TRACKDB' {
        publishDir = [
             path: { "${params.global_output_dir}/13_TRACKDB" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXECUTOR/PROFILES CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
     slurm {
        process {
            executor        = 'slurm'
            queue           = 'batch'
            scratch         = true
            stageInMode     = 'symlink'
            stageOutMode    = 'rsync'
            queue          = { task.time <= 24.h ? 'batch' : 'long' }
            clusterOptions = '--signal=USR2@180 --export=ALL,SLURM_SKIP_EPILOG=1'
            withName: '.*:PBCCS|.*:TRANSLATION|.*:TRANSAID|.*:RNASAMBA|.*:NETSTART|.*:APARENT_PREDICT' {
                array = 500
            }
            withName: '.*:ULTRA_ALIGN|.*:MINIMAP2_ALIGN|.*:PBMM2_ALIGN|.*:DESALT_ALIGN|.*:FLAIR_ALIGN|.*:ARK_ALIGN' {
                array = 50
            }
        }
        executor {
            queueSize         = 10000
            killBatchSize     = 1000000
            pollInterval      = '10 s'      // internal task-monitor tick (no SLURM RPC)
            queueStatInterval = '1 min'     // squeue cadence — halves RPC pressure
            submitRateLimit   = '5000/30sec' // max concurrent submits per node
            exitReadTimeout   = '5 min'    // tolerate slow .exitcode propagation; lets retry fire on ghosts
        }
    }   
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
        includeConfig 'conf/arm.config'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PROCESS LABELS;
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = {
        (task.exitStatus in ((130..145) + 104 + 175)) ||
        (task.exitStatus in [null, Integer.MAX_VALUE])   ? 'retry' : 'finish'
    }
    maxRetries    = 5
    maxErrors     = '-1'

    // Single processes
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Low memory processes
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:custom_process_low {
        cpus   = { 4     * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
     withLabel:process_low_long {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 10.h   * task.attempt }
    }

    // Medium memory processes
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_medium_fast {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_medium_high_memory {
        cpus   = { 4 }
        memory = { 36.GB * task.attempt }
        time   = { 12.h }
    }

    withLabel:custom_process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // High memory processes
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:process_high_fast {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_high_low_memory_fast {
        cpus   = { 12    * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // High core processes
    withLabel:process_high_core {
        cpus   = { 32    * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // Long running processes
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }

    // Strategies
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // GPU
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGISTRY CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ENVIRONMENT CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BASH OPTIONS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.global_output_dir}/PIPELINE_INFO/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.global_output_dir}/PIPELINE_INFO/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.global_output_dir}/PIPELINE_INFO/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.global_output_dir}/PIPELINE_INFO/pipeline_dag_${params.trace_report_suffix}.html"
}



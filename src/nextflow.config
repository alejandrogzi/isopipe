             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Add params to fusion concat
    withName: '.*:XORF_PREDICT_FUSION_ORFS:CONCAT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.global_output_dir}/09_XORF_PREDICTION/FUSION_CONCAT/${meta.name}" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]

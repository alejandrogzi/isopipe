              "--identity ${params.isotools_segment_identity_threshold}",
              "--tail-suffix ${params.isotools_segment_tail_suffix_length}",
              "--step-size ${params.isotools_segment_suffix_step_size}",
              "--clip5 ${params.isotools_segment_max_five_prime_clip}",
              "--clip3 ${params.isotools_segment_max_three_prime_clip}",
              "--p2p ${params.isotools_segment_hmm_transition_probability}",
              "-E ${params.isotools_segment_hmm_emission_probability}",
              "--tag",
              "-B",
              "-X",
              "-F"
            ]

            return args.join(' ')
        }
        ext.keep_temp = { params.minimap2_align_keep_sam }
    }

   withName: '.*:COLLAPSE_TWINS' {
        publishDir = [
            path: { "${params.global_output_dir}/07A_COLLAPSE_TWINS" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = {
            def args = [ 
                "--max-five-utr-length ${params.collapse_shrink_twins_five_prime_extension}",
                "--max-three-utr-length ${params.collapse_shrink_twins_three_prime_extension}",
                "--collapse-mode ${params.collapse_shrink_twins_mode}",
            ]

            return args.join(' ')
        }
